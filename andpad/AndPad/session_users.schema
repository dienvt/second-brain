# -*- mode: ruby -*-
# vi: set ft=ruby :

create_table "session_users", id: :string, limit: 36, options: "ENGINE=InnoDB DEFAULT CHARSET=utf8mb4", collation: "utf8mb4_general_ci", force: :cascade do |t|
  t.string "session_id", null: false
  t.integer "user_id", null: false
  t.datetime "started_at", limit: 3, null: true
  t.datetime "ended_at", limit: 3, null: true
  t.integer "status", null: false, default: 0
  t.string "metadata", null: true
  t.datetime "created_at", limit: 3, default: -> { "CURRENT_TIMESTAMP(3)" }, null: false
  t.datetime "updated_at", limit: 3, default: -> { "CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3)" }, null: false

  t.index ["session_id"], name: "index_session_users_on_session_id"
  t.index ["session_id", "user_id"], name: "uk_session_user", unique: true
  t.index ["created_at"], name: "index_session_users_created_at"
  t.index ["updated_at"], name: "index_session_users_updated_at"
end
